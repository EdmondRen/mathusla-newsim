define lepall = mu+ mu-
define vorlepall = vl vl~ lepall
generate p p  > lepall vorlepall
output proc_sm_muprod_wz_nomatch
launch
1
0
set ebeam1 = 7000 # Set beam to 14 TeV
set ebeam2 = 7000 # Set beam to 14 TeV
set ickkw = 1
set xqcut = 20.0
set ptl   = 20.0
set etal  = 2.0
set drll  = 0
set iseed = 1
set use_syst = False
set pythia8_card HEPMCoutput:file hepmc
done